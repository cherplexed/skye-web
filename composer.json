{
  "name": "shypig/skye-web",
  "description": "Isle of Skye guide: WordPress plugin skye-core, local stack and seed data.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": {
    "psr-4": { "Skye\\": "wp-content/plugins/skye-core/src/" }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "fix": "phpcbf",
    "acf-json": "php wp-content/plugins/skye-core/tools/generate-acf-json.php"
  },
  "config": {
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
    "sort-packages": true
  }
}
