<?xml version="1.0"?>
<ruleset name="skye-web">
  <description>WordPress coding standard for skye-core, relaxed where PHP 8 idioms are preferred.</description>
  <file>wp-content/plugins/skye-core</file>
  <exclude-pattern>*/acf-json/*</exclude-pattern>
  <exclude-pattern>*/tools/*</exclude-pattern>
  <arg name="extensions" value="php"/>
  <arg value="sp"/>
  <config name="minimum_supported_wp_version" value="6.5"/>
  <config name="testVersion" value="8.2-"/>
  <rule ref="WordPress">
    <exclude name="WordPress.Files.FileName"/>
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
    <exclude name="WordPress.PHP.YodaConditions"/>
    <exclude name="Squiz.Commenting"/>
    <exclude name="Generic.Commenting"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName"/>
    <exclude name="WordPress.WP.I18n.NonSingularStringLiteralText"/>
    <exclude name="Universal.Operators.DisallowShortTernary"/>
  </rule>
  <rule ref="WordPress.WP.I18n">
    <properties><property name="text_domain" type="array" value="skye-core"/></properties>
  </rule>
</ruleset>
