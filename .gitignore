# Entorno
.env
docker/data/
# Zips de Bricks y WPML descargados de vuestras cuentas (con licencia: no se versionan)
docker/licensed/*
!docker/licensed/README.md
# Fotos originales: pesan y tienen derechos; se suben a WordPress con `wp skye photos import`
docker/photos/*
!docker/photos/README.md
!docker/photos/photos.example.csv

# WordPress core y terceros: se instalan, no se versionan
wp-content/plugins/*
!wp-content/plugins/skye-core/
wp-content/themes/*
!wp-content/themes/skye-child/
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/languages/

# Dependencias y artefactos
vendor/
node_modules/
*.log
.phpunit.result.cache
.DS_Store
