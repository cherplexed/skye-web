# Copiar a .env. Nunca versionar .env.

# Local
WP_PORT=8080
WP_HOME=http://localhost:8080
WP_ENV=local
WP_DEBUG=1

DB_NAME=skye
DB_USER=skye
DB_PASSWORD=skye
DB_ROOT_PASSWORD=root

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# Licencias (opcional en local; sin ACF Pro el plugin usa sus propios metaboxes mínimos)
ACF_PRO_KEY=
BRICKS_LICENSE_KEY=
WPML_SITE_KEY=

# Bókun (solo test/prod)
BOKUN_ACCESS_KEY=
BOKUN_SECRET_KEY=
BOKUN_VENDOR_ID=
# Vacío = producción (https://api.bokun.io). Entorno de pruebas de Bókun: https://api.bokuntest.com
BOKUN_BASE_URL=

# Revolut Merchant API (checkout propio). 'sandbox' salvo que ponga 'production'.
# Claves de la consola de API de Revolut, permiso Merchant. Nunca en el chat ni en el repo.
REVOLUT_ENV=sandbox
REVOLUT_PUBLIC_KEY=
REVOLUT_SECRET_KEY=
