# Copiar a .env. Nunca versionar .env.

# Local
WP_PORT=8080
WP_HOME=http://localhost:8080
WP_ENV=local
WP_DEBUG=1

DB_NAME=skye
DB_USER=skye
DB_PASSWORD=skye
DB_ROOT_PASSWORD=root

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# Licencias (opcional en local; sin ACF Pro el plugin usa sus propios metaboxes mínimos)
ACF_PRO_KEY=
BRICKS_LICENSE_KEY=
WPML_SITE_KEY=

# Bókun (solo test/prod)
BOKUN_ACCESS_KEY=
BOKUN_SECRET_KEY=
BOKUN_VENDOR_ID=
